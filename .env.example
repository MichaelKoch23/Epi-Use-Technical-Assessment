# Required. Pooled PostgreSQL connection string, on the asyncpg driver.
# Neon's console gives you a libpq string - three changes are needed:
#   postgresql://  ->  postgresql+asyncpg://
#   ?sslmode=require&channel_binding=require  ->  ?ssl=require
#   use the -pooler host (Connection pooling ON in the Connect dialog)
# postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?ssl=require
DATABASE_URL=
# Required. At least 32 characters of real entropy: `openssl rand -hex 32`.
# The app refuses to start on a short or well-known value.
JWT_SECRET=

# Optional; the defaults below are what the app uses when these are unset.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Comma-separated. Not needed for the deployed service, where the SPA is
# same-origin. "*" is rejected: the API is served with credentials.
CORS_ORIGINS=http://localhost:5173

# 404 = fall back to client-rendered initials; identicon/retro/mp = let
# Gravatar serve a generated image for addresses with no photo.
GRAVATAR_DEFAULT_IMAGE=identicon
# Optional. Unlocks the full profile payload for /employees/gravatar-prefill.
GRAVATAR_API_KEY=
GRAVATAR_API_TIMEOUT_SECONDS=3.0

# Only "production"/"prod" is special: it switches off /docs, /redoc and
# /openapi.json, and adds HSTS. Anything else behaves as development.
ENVIRONMENT=development
DB_POOL_SIZE=5
# Cap on a spreadsheet import, in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880
PORT=8080
