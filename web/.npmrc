# openapi-typescript's peer range (typescript ^5.x) hasn't caught up with
# the TypeScript 6 already used here - a real dependency, not something to
# work around per-invocation. Without this, `npm ci` (used by the
# Dockerfile, for a reproducible build) fails where a plain `npm install`
# wouldn't, because `npm ci` enforces peer ranges strictly by default.
legacy-peer-deps=true
